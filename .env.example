# Почта для приёма заявок (SMTP)
# Скопируйте этот файл в .env и заполните своими данными.
# .env НЕ коммитится в git (см. .gitignore)

# --- Куда присылать заявки ---
MAIL_TO=owner@example.ru

# --- Через какой сервер отправлять ---
# Яндекс.Почта (нужен пароль приложения, не основной пароль!)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.ru
SMTP_PASS=пароль_приложения

# Отправитель в письме (обычно = SMTP_USER)
MAIL_FROM=noreply@example.ru

# Порт сайта
PORT=3000

# Альтернативы:
# Mail.ru:  SMTP_HOST=smtp.mail.ru  SMTP_PORT=465
# Gmail:    SMTP_HOST=smtp.gmail.com SMTP_PORT=465
# Timeweb:  SMTP_HOST=smtp.timeweb.ru SMTP_PORT=465
